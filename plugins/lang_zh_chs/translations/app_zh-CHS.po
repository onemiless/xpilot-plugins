msgid "Big-screen tile: local time and date. Display only; on by default."
msgstr "大屏磁贴显示本地时间和日期；仅显示，默认开启。"

msgid "Big-screen tile: speed limit, road name and next maneuver from any map or navigation provider. Display only; on by default."
