{
  "id": "tesla_eap",
  "name": "Tesla EAP Mode",
  "version": "1.0.0",
  "api": 1,
  "use": "onroad",
  "category": "engagement",
  "entry": "plugin:TeslaEap",
  "author": "xpilot",
  "description": "Stock Autopilot mode, like t2can Advanced EAP. While on, SP never engages and the panda passes the car's own Autopilot through (stock Autosteer, TACC, Navigate on Autopilot). When Navigate on Autopilot asks for a lane change, it taps the turn stalk after the set delay, only toward a side the car reports free. Needs the vehicle-bus harness and panda firmware with STOCK_AP. Enable while parked, then restart.",
  "priority": 100,
  "enable_param": "XpTeslaEap",
  "claims": [
    "role:stock.ap",
    "role:engagement.state",
    "can.tx:0x249:1"
  ],
  "settings": [
    {
      "key": "XpTeslaEapDelay",
      "label": "Blinker delay",
      "range": [
        0,
        50,
        5,
        "s",
        10
      ]
    }
  ],
  "params": {
    "XpTeslaEap": {
      "type": "BOOL",
      "default": "0"
    },
    "XpTeslaEapDelay": {
      "type": "INT",
      "default": "20",
      "note": "0.1 s; NoA lane-change request to stalk tap"
    }
  },
  "requires": {
    "hooks": [
      "engagement"
    ],
    "rule_abi": 1
  },
  "rules": [
    {
      "type": "template_clone.v1",
      "tx_bus": 1,
      "rx_bus": 1,
      "template_ttl_us": 300000,
      "min_interval_us": 50000,
      "session": 2,
      "max_count": 30,
      "idle_reset_us": 0,
      "window_us": 10000000,
      "counter": {
        "kind": 1,
        "bit_offset": 8,
        "width": 4
      },
      "tx_checksum": {
        "kind": 0,
        "checksum_byte": 0
      },
      "rx_checksum": {
        "kind": 0,
        "checksum_byte": 0
      },
      "predicate_mask": [
        0,
        0,
        7,
        0,
        0,
        0,
        0,
        0
      ],
      "predicate_value": [
        0,
        0,
        0,
        0,
        0,
        0,
        0,
        0
      ],
      "constant_mask": [
        0,
        0,
        0,
        0,
        0,
        0,
        0,
        0
      ],
      "constant_value": [
        0,
        0,
        0,
        0,
        0,
        0,
        0,
        0
      ],
      "tx_address": 585,
      "rx_address": 585,
      "tx_length": 4,
      "rx_length": 4,
      "copy_mask": [
        0,
        240,
        248,
        255,
        0,
        0,
        0,
        0
      ],
      "fields": [
        {
          "bit_offset": 0,
          "width": 8,
          "min": 0,
          "max": 255,
          "exempt_values": []
        },
        {
          "bit_offset": 16,
          "width": 3,
          "min": 2,
          "max": 6,
          "exempt_values": []
        }
      ],
      "legal_tuples": [
        {
          "field_mask": 2,
          "values": [
            0,
            2
          ]
        },
        {
          "field_mask": 2,
          "values": [
            0,
            6
          ]
        }
      ]
    }
  ]
}
